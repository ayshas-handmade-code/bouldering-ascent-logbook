rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidLocation(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.type is string && (data.type == 'gym' || data.type == 'outdoor')
          && data.isFavorite is bool
          && data.userId is string && data.userId == request.auth.uid
          && (!('city' in data) || (data.city is string && data.city.size() <= 120))
          && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp)
          && (!('wallLocations' in data) || (data.wallLocations is list && data.wallLocations.size() <= 50));
    }

    function isValidSession(data) {
      return data.id is string && data.id.size() <= 128
          && data.date is string && data.date.size() <= 20
          && data.locationId is string && data.locationId.size() <= 128
          && data.locationName is string && data.locationName.size() <= 120
          && data.locationType is string && (data.locationType == 'gym' || data.locationType == 'outdoor')
          && data.climbsCount is int
          && data.notes is string && data.notes.size() <= 10000
          && data.routes is list && data.routes.size() <= 500
          && data.userId is string && data.userId == request.auth.uid
          && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    // --- Locations Rules ---
    match /locations/{locationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && isValidId(locationId) 
                    && incoming().id == locationId
                    && isValidLocation(incoming())
                    && incoming().keys().hasAll(['id', 'name', 'type', 'isFavorite', 'userId'])
                    && incoming().keys().size() <= 8;

      allow update: if isSignedIn()
                    && existing().userId == request.auth.uid
                    && isValidLocation(incoming())
                    && incoming().id == existing().id
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'isFavorite', 'city', 'createdAt', 'wallLocations']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Sessions Rules ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow write: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn()
                    && existing().userId == request.auth.uid
                    && isValidSession(incoming())
                    && incoming().id == existing().id
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'locationId', 'locationName', 'locationType', 'climbsCount', 'notes', 'routes', 'createdAt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
